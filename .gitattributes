# Handle line endings automatically for text files.
* text=auto

# Force LF line endings for source files
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.swift text eol=lf
*.h text eol=lf
*.m text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.rc text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
