namespace rust_signer {
    sequence<u8> process_transaction_data(sequence<u8> data);
    boolean verify_signature(sequence<u8> public_key, sequence<u8> message, sequence<u8> signature);
};

interface RustSigner {
    constructor();
    sequence<u8> process_transaction_data(sequence<u8> data);
    boolean verify_signature(sequence<u8> public_key, sequence<u8> message, sequence<u8> signature);
};
