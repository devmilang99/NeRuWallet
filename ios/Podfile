# Set platform to 13.0 to resolve the "automatically assigning platform" warning
platform :ios, '13.0'

# The following has been generated by [Flutter]. Do not edit.
target_app_path = 'Runner'

def flutter_root
  generated_flutter_build_config = JSON.parse(File.read(File.join(__dir__, 'Flutter', 'generated_flutter_build_config.json')))
  File.expand_path(generated_flutter_build_config['flutterRoot'])
rescue
  File.expand_path(File.join('..', '..', '..', 'flutter'))
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Explicitly set the deployment target to avoid warnings and ensure compatibility
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end
